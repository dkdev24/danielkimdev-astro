---
// English blog post route (/blog/<slug>/). Paths + neighbours + counterpart are
// built by getBlogPaths('en'); the layout renders the chrome around Content.
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getBlogPaths } from '../../utils/blog';

export const getStaticPaths = () => getBlogPaths('en');

const { post, newer, older, counterpart, seriesIndex, seriesTotal, seriesPrev, seriesNext } =
	Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
	post={post}
	headings={headings}
	newer={newer}
	older={older}
	counterpart={counterpart}
	seriesIndex={seriesIndex}
	seriesTotal={seriesTotal}
	seriesPrev={seriesPrev}
	seriesNext={seriesNext}
>
	<Content />
</BlogPost>
