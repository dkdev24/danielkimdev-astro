---
import TagArchivePage from '../../../components/TagArchivePage.astro';
import { getBlogTagPaths } from '../../../utils/tags';

export const getStaticPaths = () => getBlogTagPaths('en');

const { tag, tagLabel, entries } = Astro.props;
---

<TagArchivePage lang="en" kind="blog" tag={tag} tagLabel={tagLabel} entries={entries} />
