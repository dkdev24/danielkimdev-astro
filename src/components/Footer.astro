---
// Site footer (Stage 08). MiniMax-style dark footer (DESIGN-minimax §2) — it
// reads dark in BOTH themes (charcoal bg, light-on-dark text), so its colors
// are pinned to fixed brand tokens, not the theme-flipping semantic vars.
// Injected into BaseLayout's `footer` slot. Social row is LinkedIn + email only
// (locked 2026-06-28 — no X/GitHub); RSS points at the root feed (per-locale
// feeds land in Stage 18).
import { CONTACT_EMAIL, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-top">
			<p class="footer-tagline">{t('footer.tagline')}</p>

			<nav class="footer-social" aria-label={t('footer.social')}>
				<a href={SOCIAL_LINKS.linkedin} rel="me noopener" target="_blank">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<path
							fill="currentColor"
							d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.64h.05c.53-1 1.83-2.05 3.76-2.05C20.3 8.59 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H9z"
						></path>
					</svg>
					<span>{t('footer.linkedin')}</span>
				</a>
				<a href={`mailto:${CONTACT_EMAIL}`}>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="5" width="18" height="14" rx="2"></rect>
							<path d="m3 7 9 6 9-6"></path>
						</g>
					</svg>
					<span>{t('footer.email')}</span>
				</a>
				{/* TODO(stage-18): swap to the per-locale feed once KO feed exists. */}
				<a href="/rss.xml">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<g fill="currentColor">
							<circle cx="6.18" cy="17.82" r="2.18"></circle>
							<path
								d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83C19.56 11.4 12.6 4.44 4 4.44zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"
							></path>
						</g>
					</svg>
					<span>{t('footer.rss')}</span>
				</a>
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="footer-meta">
				<span>&copy; {year} {SITE_AUTHOR}. {t('footer.rights')}</span>
				<span class="footer-built">{t('footer.builtWith')}</span>
			</p>
			<div class="footer-actions">
				<LanguageToggle />
				<ThemeToggle lang={lang} />
			</div>
		</div>
	</div>
</footer>

<style>
	/* Always-dark footer (DESIGN-minimax §2) — fixed charcoal regardless of theme. */
	.site-footer {
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		margin-top: var(--space-20);
	}
	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		padding-block: var(--space-16) var(--space-12);
	}

	.footer-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-6);
	}
	.footer-tagline {
		margin: 0;
		max-width: 38ch;
		font-family: var(--font-ui);
		font-size: var(--text-base);
		color: rgba(255, 255, 255, 0.92);
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.footer-social a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1_5);
		min-height: 44px;
		padding: var(--space-2) var(--space-3_5);
		border-radius: var(--radius-pill);
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-on-dark);
		text-decoration: none;
		transition: background var(--motion-fast-ease), color var(--motion-fast-ease);
	}
	.footer-social a:hover {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-6);
		padding-top: var(--space-8);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.footer-meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.6);
	}

	.footer-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
</style>
