---
// Shared Portfolio page (Stage 15), fed by `lang`. Collection-driven grid with
// a client-side tag filter (progressive enhancement — full list without JS).
// Entries are split into Career work and Side projects by category
// (`getPortfolioGroup`); the tag filter spans both sections.
// Each card summarizes an entry and links to its detail page (Stage 27,
// `/portfolio/[slug]`), which owns the full body + links. Adding a portfolio
// entry = one file, no edits.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { getTagPath } from '../utils/tags';
import { getPortfolioPath, getPortfolioGroup, PORTFOLIO_GROUPS } from '../utils/portfolio';
import { SITE_DESCRIPTION_BY_LOCALE } from '../consts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (
	await getCollection('portfolio', (e) => e.data.lang === lang)
).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const groups = PORTFOLIO_GROUPS.map((group) => ({
	group,
	items: entries.filter((e) => getPortfolioGroup(e.data.category) === group),
})).filter((g) => g.items.length > 0);

// Distinct tags across this locale's items, in first-seen order — drives the filter.
const filterTags: string[] = [];
for (const entry of entries) {
	for (const tg of entry.data.tags) if (!filterTags.includes(tg)) filterTags.push(tg);
}
---

<BaseLayout title={`${t('portfolio.title')} — Daniel Kim`} description={SITE_DESCRIPTION_BY_LOCALE[lang]} lang={lang}>
	<section class="container pf">
		<header class="pf__head">
			<h1>{t('portfolio.title')}</h1>
			<p class="pf__intro">{t('portfolio.intro')}</p>
		</header>

		<!-- Tag filter (progressive enhancement: no-JS shows the full list below). -->
		<div class="pf-filters" role="group" aria-label={t('portfolio.filterByTag')}>
			<Tag tag="all" lang={lang} label={t('portfolio.allTags')} interactive pressed data-filter="all" />
			{filterTags.map((tg) => <Tag tag={tg} lang={lang} interactive data-filter={tg} />)}
		</div>

		{
			entries.length > 0 ? (
				groups.map(({ group, items }) => (
					<section class="pf-group" aria-labelledby={`pf-group-${group}`}>
						<header class="pf-group__head">
							<h2 id={`pf-group-${group}`}>{t(`portfolio.groups.${group}`)}</h2>
							<p class="pf-group__intro">{t(`portfolio.groups.${group}Intro`)}</p>
						</header>
						<ul class="pf-grid">
							{items.map((entry) => (
								<li class="pf-card" data-tags={entry.data.tags.join(' ')}>
									<Card as="article" interactive>
										<h3 class="pf-card__title">
											<a href={getPortfolioPath(entry)}>{entry.data.title}</a>
										</h3>
										<p class="pf-card__meta">
											{[entry.data.role, entry.data.org, entry.data.period]
												.filter(Boolean)
												.join(' · ')}
										</p>
										<p class="pf-card__summary">{entry.data.summary}</p>
										<div class="pf-card__tags">
											{entry.data.tags.map((tg) => (
												<Tag tag={tg} lang={lang} href={getTagPath('portfolio', tg, lang)} />
											))}
										</div>
										<p class="pf-card__more">
											<a href={getPortfolioPath(entry)}>{t('portfolio.viewProject')} →</a>
										</p>
									</Card>
								</li>
							))}
						</ul>
					</section>
				))
			) : (
				<p class="pf-empty">{t('portfolio.noItems')}</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.pf {
		padding-block: var(--space-12) var(--space-16);
	}
	.pf__head {
		margin-bottom: var(--space-8);
	}
	.pf__intro {
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
		max-width: 60ch;
	}

	.pf-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-8);
	}

	.pf-group + .pf-group {
		margin-top: var(--space-12);
	}
	.pf-group__head {
		margin-bottom: var(--space-6);
	}
	.pf-group__head h2 {
		margin: 0 0 var(--space-1);
	}
	.pf-group__intro {
		margin: 0;
		color: var(--color-text-secondary);
		max-width: 60ch;
	}
	/* A section whose cards are all filtered out (JS sets [hidden]). */
	.pf-group[hidden] {
		display: none;
	}

	.pf-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: var(--space-6);
	}
	/* Filtered-out cards (JS sets [hidden]); override .card's display:block. */
	.pf-card[hidden] {
		display: none;
	}
	.pf-card__title {
		margin: 0 0 var(--space-1);
		font-size: var(--text-h4);
	}
	.pf-card__title a {
		color: var(--color-text-heading);
		text-decoration: none;
	}
	.pf-card__title a:hover {
		color: var(--color-link);
	}
	.pf-card__meta {
		margin: 0 0 var(--space-3);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.pf-card__summary {
		margin: 0 0 var(--space-4);
		color: var(--color-text-secondary);
	}
	.pf-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1_5);
		margin-bottom: var(--space-4);
	}
	.pf-card__more {
		margin: 0;
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
	}
	.pf-card__more a {
		color: var(--color-link);
		text-decoration: none;
	}
</style>

<script>
	const filters = Array.from(document.querySelectorAll<HTMLElement>('.pf-filters [data-filter]'));
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.pf-card'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('.pf-group'));

	function apply(tag: string) {
		cards.forEach((card) => {
			const tags = (card.getAttribute('data-tags') ?? '').split(' ');
			card.hidden = tag !== 'all' && !tags.includes(tag);
		});
		groups.forEach((group) => {
			group.hidden = !group.querySelector('.pf-card:not([hidden])');
		});
		filters.forEach((f) =>
			f.setAttribute('aria-pressed', String(f.getAttribute('data-filter') === tag)),
		);
	}

	filters.forEach((f) =>
		f.addEventListener('click', () => apply(f.getAttribute('data-filter') ?? 'all')),
	);
</script>
