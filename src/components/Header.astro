---
// Site header (Stage 07): sticky pill nav (DESIGN-minimax §4) + language and
// theme toggles. Nav labels come from the i18n dictionary (Stage 05) and links
// are localized via `getLocalizedPath`, so the same component serves both
// locales. The primary nav links collapse behind a hamburger below 768px; the
// toggles stay in the bar. Injected into BaseLayout's `header` slot.
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Locale-neutral nav model; labels resolved per locale, paths localized below.
const navItems = [
	{ key: 'nav.home', path: '/' },
	{ key: 'nav.about', path: '/about/' },
	{ key: 'nav.portfolio', path: '/portfolio/' },
	{ key: 'nav.blog', path: '/blog/' },
] as const;

// Current path with any /ko prefix stripped, so active state is locale-agnostic.
const currentPath = Astro.url.pathname.replace(/^\/ko(?=\/|$)/, '') || '/';
function isActive(path: string): boolean {
	if (path === '/') return currentPath === '/';
	return currentPath === path || currentPath.startsWith(path);
}
---

<header class="site-header">
	<nav class="site-nav container" aria-label={t('nav.primaryLabel')}>
		<a class="brand" href={getLocalizedPath('/', lang)}>{SITE_TITLE}</a>

		<button
			type="button"
			class="nav-toggle"
			aria-controls="primary-nav"
			aria-expanded="false"
			aria-label={t('common.openMenu')}
			data-label-open={t('common.openMenu')}
			data-label-close={t('common.closeMenu')}
		>
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path class="bar bar-top" d="M3 6h18"></path>
					<path class="bar bar-mid" d="M3 12h18"></path>
					<path class="bar bar-bottom" d="M3 18h18"></path>
				</g>
			</svg>
		</button>

		<div class="nav-cluster">
			<ul id="primary-nav" class="nav-links">
				{
					navItems.map((item) => (
						<li>
							<a
								class:list={['nav-link', { active: isActive(item.path) }]}
								href={getLocalizedPath(item.path, lang)}
								aria-current={isActive(item.path) ? 'page' : undefined}
							>
								{t(item.key)}
							</a>
						</li>
					))
				}
			</ul>

			<div class="nav-actions">
				<LanguageToggle />
				<ThemeToggle lang={lang} />
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(8px);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		min-height: 64px;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		font-size: var(--text-lg);
		color: var(--color-text-heading);
		text-decoration: none;
		margin-right: auto;
	}

	.nav-cluster {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-pill);
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: background var(--motion-fast-ease), color var(--motion-fast-ease);
	}
	.nav-link:hover {
		background: var(--color-bg-muted);
		color: var(--color-text);
	}
	/* Pill active indicator (DESIGN-minimax §4). */
	.nav-link.active {
		background: var(--color-bg-muted);
		color: var(--color-text-heading);
		font-weight: var(--weight-semibold);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	/* Hamburger — hidden on desktop, shown < 768px. */
	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
	}

	@media (max-width: 767px) {
		.nav-toggle {
			display: inline-flex;
			order: 3;
		}
		.nav-cluster {
			order: 4;
			flex-basis: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-2);
		}
		/* Collapse the primary links into a stacked panel, toggled open. */
		.nav-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-1);
			padding-bottom: var(--space-2);
		}
		.site-nav[data-open] .nav-links {
			display: flex;
		}
		.nav-link {
			width: 100%;
		}
		.nav-actions {
			justify-content: flex-start;
			padding-bottom: var(--space-3);
		}
		.site-nav {
			flex-wrap: wrap;
		}
		/* Hide the toggles cluster until the menu is opened, to keep the closed
		   bar minimal (brand + hamburger). */
		.nav-cluster {
			display: none;
		}
		.site-nav[data-open] .nav-cluster {
			display: flex;
		}
	}
</style>

<script>
	const navMaybe = document.querySelector<HTMLElement>('.site-nav');
	const toggleMaybe = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const panelMaybe = document.querySelector<HTMLElement>('#primary-nav');

	if (navMaybe && toggleMaybe && panelMaybe) {
		const nav = navMaybe;
		const toggle = toggleMaybe;
		const panel = panelMaybe;
		const focusables = () =>
			Array.from(
				nav.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled])',
				),
			).filter((el) => el.offsetParent !== null);

		const isOpen = () => nav.hasAttribute('data-open');

		function open() {
			nav.setAttribute('data-open', '');
			toggle.setAttribute('aria-expanded', 'true');
			toggle.setAttribute('aria-label', toggle.dataset.labelClose ?? 'Close menu');
			const first = panel.querySelector<HTMLElement>('a[href]');
			first?.focus();
		}
		function close(returnFocus = true) {
			nav.removeAttribute('data-open');
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', toggle.dataset.labelOpen ?? 'Open menu');
			if (returnFocus) toggle.focus();
		}

		toggle.addEventListener('click', () => (isOpen() ? close() : open()));

		// Esc closes; Tab is trapped within the open menu.
		document.addEventListener('keydown', (e) => {
			if (!isOpen()) return;
			if (e.key === 'Escape') {
				e.preventDefault();
				close();
				return;
			}
			if (e.key === 'Tab') {
				const items = focusables();
				if (items.length === 0) return;
				const firstEl = items[0];
				const lastEl = items[items.length - 1];
				const active = document.activeElement as HTMLElement | null;
				if (e.shiftKey && active === firstEl) {
					e.preventDefault();
					lastEl.focus();
				} else if (!e.shiftKey && active === lastEl) {
					e.preventDefault();
					firstEl.focus();
				}
			}
		});

		// Click outside the header closes the menu (no focus steal).
		document.addEventListener('click', (e) => {
			if (isOpen() && !nav.contains(e.target as Node)) close(false);
		});

		// If resized back to desktop, drop the open state so layout is clean.
		const mq = window.matchMedia('(min-width: 768px)');
		mq.addEventListener('change', (e) => {
			if (e.matches && isOpen()) close(false);
		});
	}
</script>
