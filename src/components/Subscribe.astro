---
/**
 * Subscribe — Kit email signup (Buttondown 2026-10-15, switched to Kit). Owned-audience capture at
 * the end of every blog post: post → visit → signup is the metric, not views.
 *
 * Posts to our own /api/subscribe (functions/api/subscribe.ts), which signs the reader up through
 * Kit's form endpoint and tags them lang-en / lang-ko. A small script submits it in place and shows
 * the result without leaving the post. Copy follows the page language.
 * Renders nothing while KIT_FORM_ID is '' (same gate as UMAMI_WEBSITE_ID).
 */
import { KIT_FORM_ID } from '../consts';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const inputId = `subscribe-email-${lang}`;
---

{
	KIT_FORM_ID !== '' && (
		<section id="subscribe" class="subscribe" aria-labelledby="subscribe-title">
			<h2 id="subscribe-title" class="subscribe__title">{t('subscribe.title')}</h2>
			<p class="subscribe__body">{t('subscribe.body')}</p>
			<form class="subscribe__form" action="/api/subscribe" method="post" data-sending={t('subscribe.sending')} data-success={t('subscribe.success')} data-error={t('subscribe.error')}>
				<label class="subscribe__label" for={inputId}>{t('subscribe.emailLabel')}</label>
				<input
					class="subscribe__input"
					id={inputId}
					type="email"
					name="email_address"
					required
					autocomplete="email"
					placeholder={t('subscribe.placeholder')}
				/>
				<input type="hidden" name="lang" value={lang} />
				<input class="subscribe__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<button class="subscribe__button" type="submit">{t('subscribe.button')}</button>
			</form>
			<p class="subscribe__status" role="status" aria-live="polite"></p>
			<p class="subscribe__note">{t('subscribe.note')}</p>
		</section>
	)
}

<script>
	document.querySelectorAll<HTMLFormElement>('.subscribe__form').forEach((form) => {
		const status = form.parentElement!.querySelector<HTMLElement>('.subscribe__status')!;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const { sending, success, error } = form.dataset;
			status.textContent = sending ?? '';
			try {
				const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
				if (!res.ok) throw new Error(String(res.status));
				form.reset();
				status.textContent = success ?? '';
			} catch {
				status.textContent = error ?? '';
			}
		});
	});
</script>

<style>
	.subscribe {
		margin-block: var(--space-12) var(--space-8);
		padding: var(--space-6);
		border: var(--space-px) solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.subscribe__title {
		margin: 0 0 var(--space-2);
		font-size: 1.25rem;
		color: var(--color-text-heading);
	}
	.subscribe__body,
	.subscribe__note {
		margin: 0;
		color: var(--color-text-secondary);
	}
	.subscribe__note {
		margin-top: var(--space-3);
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}
	.subscribe__hp {
		position: absolute;
		left: -9999px;
	}
	.subscribe__status {
		margin: var(--space-3) 0 0;
		color: var(--color-text-secondary);
	}
	.subscribe__form {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}
	.subscribe__label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.subscribe__input {
		flex: 1 1 14rem;
		min-width: 0;
		padding: var(--space-2_5) var(--space-3_5);
		border: var(--space-px) solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
	}
	.subscribe__button {
		padding: var(--space-2_5) var(--space-4);
		border: 0;
		border-radius: var(--radius-sm);
		background: var(--color-btn-primary-bg);
		color: var(--color-text-on-brand);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.subscribe__input:focus-visible,
	.subscribe__button:focus-visible {
		outline: 2px solid var(--color-btn-primary-bg);
		outline-offset: 2px;
	}
</style>
