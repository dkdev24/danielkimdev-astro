---
// Language toggle (Stage 07). A real navigation link (works without JS) to the
// current page's counterpart in the other locale. By default it mirrors the
// current path (`/about/` ⇄ `/ko/about/`); pages without a 1:1 translation
// (e.g. a post that exists in only one locale) pass an explicit `href` to the
// locale's equivalent section so the user never lands on a 404 (PRD §7.3).
//
// Modeled as a link, not a toggle button — it navigates, so `hreflang`/`lang`
// on the anchor are the correct semantics (the label renders in the target
// language's voice for screen readers). The choice is persisted on click for
// the first-visit language hint (PRD §7.1).
import {
	getAltLocale,
	getLangFromUrl,
	getLocalizedPath,
	useTranslations,
} from '../i18n/utils';

interface Props {
	/** Explicit counterpart URL; defaults to the mirrored current path. */
	href?: string;
}

const lang = getLangFromUrl(Astro.url);
const alt = getAltLocale(lang);
const t = useTranslations(lang);
const { href } = Astro.props;
const targetPath = href ?? getLocalizedPath(Astro.url.pathname, alt);
---

<a
	class="lang-toggle"
	href={targetPath}
	hreflang={alt}
	lang={alt}
	aria-label={t('lang.switchToAria')}
	data-lang-target={alt}
>
	<svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
		</g>
	</svg>
	<span>{t('lang.switchTo')}</span>
</a>

<style>
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1_5);
		min-height: 44px;
		padding: var(--space-2) var(--space-3_5);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text-secondary);
		/*
		  The toggle carries lang="ko" (a11y) on EN pages, which would make the
		  :lang(ko) rule resolve --font-ui to Pretendard and pull a ~760KB Korean
		  webfont just to render the "한국어" label. Pin an explicit stack that has
		  no webfont — Latin via DM Sans, Korean via the system fonts (Apple SD
		  Gothic Neo / Malgun Gothic / Noto Sans KR). (Stage 20 perf.)
		*/
		font-family: var(--font-dm-sans), 'Helvetica Neue', Helvetica, Arial,
			'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		text-decoration: none;
		white-space: nowrap;
		transition: background var(--motion-fast-ease), color var(--motion-fast-ease);
	}
	.lang-toggle:hover {
		background: var(--color-bg-muted);
		color: var(--color-text);
	}
	.lang-toggle .icon {
		flex: none;
	}
</style>

<script>
	document.querySelectorAll<HTMLAnchorElement>('.lang-toggle').forEach((el) => {
		el.addEventListener('click', () => {
			try {
				localStorage.setItem('lang', el.dataset.langTarget ?? '');
			} catch {
				/* storage blocked — navigation still proceeds */
			}
		});
	});
</script>
