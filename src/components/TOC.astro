---
// Table of contents (Stage 12) — auto-built from a post's headings (Astro's
// `render()` returns them). Progressive enhancement: ships as a plain nested
// list inside a <details> (collapsible, open by default) that works with no JS;
// a small script adds scroll-spy current-section highlighting on top.
//
// API
//   headings : Astro heading list ({ depth, slug, text }[])
//   lang     : locale for the "On this page" label
//   minDepth?/maxDepth? : heading levels to include (default h2–h3)
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	lang: Lang;
	minDepth?: number;
	maxDepth?: number;
}

const { headings, lang, minDepth = 2, maxDepth = 3 } = Astro.props;
const t = useTranslations(lang);
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
---

{
	items.length > 0 && (
		<nav class="toc" aria-label={t('blog.tableOfContents')}>
			<details class="toc__details" open>
				<summary class="toc__summary">{t('blog.tableOfContents')}</summary>
				<ul class="toc__list">
					{items.map((h) => (
						<li class="toc__item" data-depth={h.depth}>
							<a class="toc__link" href={`#${h.slug}`} data-toc-link={h.slug}>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</details>
		</nav>
	)
}

<style>
	.toc {
		font-family: var(--font-ui);
		font-size: var(--text-sm);
	}
	@media (min-width: 1024px) {
		.toc {
			position: sticky;
			top: var(--space-20);
		}
	}
	.toc__summary {
		font-weight: var(--weight-semibold);
		color: var(--color-text-heading);
		cursor: pointer;
		padding: var(--space-1) 0;
	}
	.toc__list {
		list-style: none;
		margin: var(--space-2) 0 0;
		padding: 0;
		border-left: 1px solid var(--color-border-subtle);
	}
	.toc__item[data-depth='3'] {
		padding-left: var(--space-4);
	}
	.toc__link {
		display: block;
		padding: var(--space-1) var(--space-3);
		margin-left: -1px;
		border-left: 2px solid transparent;
		color: var(--color-text-secondary);
		text-decoration: none;
		line-height: var(--leading-snug);
	}
	.toc__link:hover {
		color: var(--color-text);
	}
	.toc__link.is-active {
		color: var(--color-link);
		border-left-color: var(--color-brand);
		font-weight: var(--weight-medium);
	}
</style>

<script>
	// Scroll-spy: highlight the TOC link for the heading currently in view.
	// Pure enhancement — without JS the list still works as anchor links.
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc__link'));
	if (links.length > 0 && 'IntersectionObserver' in window) {
		const headings = links
			.map((l) => document.getElementById(l.dataset.tocLink ?? ''))
			.filter((el): el is HTMLElement => el !== null);

		let activeId: string | null = null;
		const setActive = (id: string | null) => {
			if (id === activeId) return;
			activeId = id;
			links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === id));
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible[0]) setActive(visible[0].target.id);
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 0 },
		);
		headings.forEach((h) => observer.observe(h));
	}
</script>
