---
// Timeline item (Stage 12) — one entry on the About career timeline, rendered
// from the `timeline` collection (Stage 14 maps fields → these props). Vertical
// rail with a brand dot marker; the rail stops after the last item.
//
// API
//   title  : role (e.g. "Product Manager")
//   org?   : organization (e.g. "DoveRunner / PallyCon")
//   period?: display range (e.g. "2021–present")
// Body (summary) goes in the default slot.
//
// Render inside an <ol class="timeline"> for correct list semantics.
interface Props {
	title: string;
	org?: string;
	period?: string;
}

const { title, org, period } = Astro.props;
---

<li class="timeline-item">
	<span class="timeline-item__marker" aria-hidden="true"></span>
	<div class="timeline-item__content">
		{period && <p class="timeline-item__period">{period}</p>}
		<h3 class="timeline-item__title">
			{title}{org && <span class="timeline-item__org"> · {org}</span>}
		</h3>
		<div class="timeline-item__body"><slot /></div>
	</div>
</li>

<style>
	.timeline-item {
		position: relative;
		list-style: none;
		padding-left: var(--space-8);
		padding-bottom: var(--space-8);
	}
	/* The rail. */
	.timeline-item::before {
		content: '';
		position: absolute;
		left: 5px;
		top: var(--space-1);
		bottom: 0;
		width: 2px;
		background: var(--color-border);
	}
	/* Stop the rail after the final item. */
	.timeline-item:last-child::before {
		bottom: auto;
		height: var(--space-4);
	}
	.timeline-item__marker {
		position: absolute;
		left: 0;
		top: var(--space-1);
		width: 12px;
		height: 12px;
		border-radius: var(--radius-pill);
		background: var(--color-brand);
		border: 2px solid var(--color-bg);
	}
	.timeline-item__period {
		margin: 0 0 var(--space-0_5);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.timeline-item__title {
		margin: 0 0 var(--space-1);
		font-size: var(--text-h4);
	}
	.timeline-item__org {
		font-weight: var(--weight-regular);
		color: var(--color-text-secondary);
	}
	.timeline-item__body {
		color: var(--color-text-secondary);
	}
	.timeline-item__body :global(:last-child) {
		margin-bottom: 0;
	}
</style>
