---
// Document head + SEO layer (finalized Stage 18). Owns: global meta, fonts, the
// no-flash theme script, canonical, per-page OpenGraph/Twitter, hreflang
// alternates, per-locale RSS link, and optional JSON-LD. Imports global.css so
// every page (it renders inside BaseLayout's <head>) gets the styles.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { CF_ANALYTICS_TOKEN, DEFAULT_OG_IMAGE, SITE_TITLE, UMAMI_WEBSITE_ID } from '../consts';
import { Font } from 'astro:assets';
import ThemeScript from './ThemeScript.astro';
import type { Lang } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	/** Optimized OG image (e.g. a post hero) — used when no `ogImage` override. */
	image?: ImageMetadata;
	/** Explicit OG image path override (e.g. post `ogImage` frontmatter). */
	ogImage?: string;
	/** Marks the page as an article for OG (posts). */
	articleMeta?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
	/** hreflang counterparts; omit/undefined → no alternates emitted. */
	alternates?: { en?: string; ko?: string };
	/** Structured data (one object or several). */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** When true, ask crawlers not to index this page (404, throwaway, etc.). */
	noindex?: boolean;
}

const {
	title,
	description,
	lang,
	image,
	ogImage,
	articleMeta,
	alternates,
	jsonLd,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OG image precedence: explicit per-page override → optimized asset → default.
const ogImageURL = ogImage
	? new URL(ogImage, Astro.site)
	: image
		? new URL(image.src, Astro.url)
		: new URL(DEFAULT_OG_IMAGE, Astro.site);

const ogType = articleMeta ? 'article' : 'website';
const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';
const ogLocaleAlt = lang === 'en' ? 'ko_KR' : 'en_US';

// Absolute hreflang URLs (only the locales actually provided).
const hreflangs: { hreflang: string; href: string }[] = [];
if (alternates) {
	if (alternates.en) {
		const href = new URL(alternates.en, Astro.site).href;
		hreflangs.push({ hreflang: 'en', href });
		hreflangs.push({ hreflang: 'x-default', href });
	}
	if (alternates.ko) {
		hreflangs.push({ hreflang: 'ko', href: new URL(alternates.ko, Astro.site).href });
	}
}
const hasCounterpart = alternates ? Boolean(alternates.en && alternates.ko) : false;

const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Cloudflare Web Analytics beacon (Stage 22): cookieless, prod-only, and only
// when a token is configured. Off in dev/preview and a no-op when unset.
const showAnalytics = import.meta.env.PROD && CF_ANALYTICS_TOKEN !== '';

// Umami Cloud tracker (2026-08-05): same prod-only + configured-only gating as
// above, so dev/preview page loads never reach the Hobby plan's event quota.
const showUmami = import.meta.env.PROD && UMAMI_WEBSITE_ID !== '';
---

<!-- No-flash theme resolver — must run before paint (Stage 03). -->
<ThemeScript />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={lang === 'en' ? SITE_TITLE : `${SITE_TITLE} (한국어)`}
	href={new URL(lang === 'en' ? 'rss.xml' : 'ko/rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!--
  Fonts (Stage 04, perf-tuned Stage 20). Each <Font> emits the @font-face +
  defines its --font-* CSS var (consumed by the role vars in tokens.css), so
  every referenced family must be rendered or its var falls back to Helvetica.
  Preload is LOCALE-SPECIFIC: Pretendard's Korean weights are ~750KB each (~2.3MB
  for the 3 weights), so preloading them on EN pages (which render no Korean) was
  pulling 2.3MB for nothing. We now preload only the locale's primary body face —
  DM Sans on EN, Pretendard on KO — and merely declare the other (on-demand, so
  it's fetched only if a glyph actually needs it). The rest load on demand with
  font-display: swap (set in astro.config.mjs).
-->
{lang === 'en' ? <Font cssVariable="--font-dm-sans" preload /> : <Font cssVariable="--font-dm-sans" />}
{lang === 'ko' ? <Font cssVariable="--font-pretendard" preload /> : <Font cssVariable="--font-pretendard" />}
<Font cssVariable="--font-outfit" />
<Font cssVariable="--font-poppins" />
<Font cssVariable="--font-roboto" />

<!-- Canonical + hreflang alternates (only where counterparts are declared). -->
<link rel="canonical" href={canonicalURL} />
{hreflangs.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
{hasCounterpart && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
{
	articleMeta && (
		<>
			<meta property="article:published_time" content={articleMeta.publishedTime} />
			{articleMeta.modifiedTime && (
				<meta property="article:modified_time" content={articleMeta.modifiedTime} />
			)}
			{articleMeta.tags?.map((tg) => <meta property="article:tag" content={tg} />)}
		</>
	)
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Structured data (JSON-LD) -->
{
	jsonLdList.map((data) => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
	))
}

<!-- Cloudflare Web Analytics — cookieless beacon (Stage 22), prod-only + token-gated. -->
{
	showAnalytics && (
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
		/>
	)
}

<!-- Umami Cloud — cookieless analytics, prod-only + id-gated (see consts.ts). -->
{
	showUmami && (
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} />
	)
}
