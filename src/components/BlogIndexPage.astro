---
// Shared Blog index (Stage 16), fed by `lang` — both `/blog/` (EN) and
// `/ko/blog/` render it. Reverse-chronological list of the current locale's
// posts (PRD §7.4) with a client-side tag filter (progressive enhancement —
// full list without JS) and draft exclusion in production. Search + pagination
// stay P1. Reuses the Stage 15 portfolio filter pattern.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import type { Lang } from '../i18n/utils';
import { formatDate, formatReadingTime, useTranslations } from '../i18n/utils';
import { SITE_DESCRIPTION_BY_LOCALE } from '../consts';
import { readingTimeMinutes } from '../utils/readingTime';
import { getPostPath } from '../utils/blog';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Current-locale posts, reverse-chron. `import.meta.env.PROD` drops drafts in
// production builds but keeps them visible during `astro dev`.
const posts = (
	await getCollection(
		'blog',
		(e) => e.data.lang === lang && (import.meta.env.PROD ? !e.data.draft : true),
	)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Distinct tags across this locale's posts, in first-seen order — drives the filter.
const filterTags: string[] = [];
for (const post of posts) {
	for (const tg of post.data.tags) if (!filterTags.includes(tg)) filterTags.push(tg);
}

---

<BaseLayout title={`${t('blog.title')} — Daniel Kim`} description={SITE_DESCRIPTION_BY_LOCALE[lang]} lang={lang}>
	<section class="container blog">
		<header class="blog__head">
			<h1>{t('blog.title')}</h1>
			<p class="blog__intro">{t('blog.intro')}</p>
		</header>

		{
			filterTags.length > 0 && (
				<div class="blog-filters" role="group" aria-label={t('blog.filterByTag')}>
					<Tag tag="all" lang={lang} label={t('blog.allTags')} interactive pressed data-filter="all" />
					{filterTags.map((tg) => (
						<Tag tag={tg} lang={lang} interactive data-filter={tg} />
					))}
				</div>
			)
		}

		{
			posts.length > 0 ? (
				<ul class="blog-list">
					{posts.map((post) => (
						<li class="blog-item" data-tags={post.data.tags.join(' ')}>
							<Card as="article" interactive>
								<p class="blog-item__meta">
									<time datetime={post.data.pubDate.toISOString()}>
										{formatDate(post.data.pubDate, lang)}
									</time>
									<span aria-hidden="true"> · </span>
									<span>{formatReadingTime(readingTimeMinutes(post.body, lang), lang)}</span>
									{post.data.draft && (
										<>
											<span aria-hidden="true"> · </span>
											<span class="blog-item__draft">{t('blog.draft')}</span>
										</>
									)}
								</p>
								<h2 class="blog-item__title">
									<a href={getPostPath(post)}>{post.data.title}</a>
								</h2>
								<p class="blog-item__excerpt">{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<div class="blog-item__tags">
										{post.data.tags.map((tg) => (
											<Tag tag={tg} lang={lang} />
										))}
									</div>
								)}
							</Card>
						</li>
					))}
				</ul>
			) : (
				<p class="blog-empty">{t('blog.noPosts')}</p>
			)
		}

		{
			posts.length > 0 && (
				<div class="blog-more" hidden data-showing-template={t('blog.showingCount')}>
					<p class="blog-more__status" aria-live="polite" />
					<Button variant="secondary" id="blog-load-more" data-page-size="6">
						{t('blog.loadMore')}
					</Button>
				</div>
			)
		}
	</section>
</BaseLayout>

<style>
	.blog {
		padding-block: var(--space-12) var(--space-16);
	}
	.blog__head {
		margin-bottom: var(--space-8);
	}
	.blog__intro {
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
		max-width: 60ch;
	}

	.blog-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-8);
	}

	.blog-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
		gap: var(--space-6);
	}
	/* Filtered-out items (JS sets [hidden]); override .card's display:block. */
	.blog-item[hidden] {
		display: none;
	}
	.blog-item__meta {
		margin: 0 0 var(--space-2);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.blog-item__draft {
		color: var(--color-text);
		font-weight: var(--weight-medium);
	}
	.blog-item__title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-h4);
	}
	.blog-item__title a {
		color: var(--color-text-heading);
		text-decoration: none;
	}
	.blog-item__title a:hover {
		color: var(--color-link);
	}
	.blog-item__excerpt {
		margin: 0 0 var(--space-4);
		color: var(--color-text-secondary);
	}
	.blog-item__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1_5);
	}
	.blog-empty {
		color: var(--color-text-secondary);
	}

	/* Load-more controls — JS-only (hidden without JS so the full list shows). */
	.blog-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-10);
	}
	/* Explicit override: `.blog-more`'s flex display would otherwise beat the
	   default [hidden] rule, showing the block (and a dead button) without JS. */
	.blog-more[hidden] {
		display: none;
	}
	.blog-more__status {
		margin: 0;
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
</style>

<script>
	// Unified controller for the blog index: the tag filter and the "load more"
	// pager share one render pass so they compose. Visibility of each item is a
	// function of (a) whether it matches the active tag and (b) whether it falls
	// within the current visible window. Without JS none of this runs, so every
	// item stays visible and the load-more block stays hidden (progressive
	// enhancement — matches the draft/no-JS behavior elsewhere).
	const filters = Array.from(document.querySelectorAll<HTMLElement>('.blog-filters [data-filter]'));
	const items = Array.from(document.querySelectorAll<HTMLElement>('.blog-item'));
	const more = document.querySelector<HTMLElement>('.blog-more');
	const status = document.querySelector<HTMLElement>('.blog-more__status');
	const loadMoreBtn = document.querySelector<HTMLElement>('#blog-load-more');

	const PAGE_SIZE = Number(loadMoreBtn?.dataset.pageSize) || 6;
	const showingTemplate = more?.dataset.showingTemplate ?? '';

	let activeTag = 'all';
	let visible = PAGE_SIZE;

	function matches(item: HTMLElement) {
		if (activeTag === 'all') return true;
		return (item.getAttribute('data-tags') ?? '').split(' ').includes(activeTag);
	}

	function render() {
		let matched = 0;
		items.forEach((item) => {
			if (matches(item)) {
				item.hidden = matched >= visible; // within the visible window?
				matched += 1;
			} else {
				item.hidden = true;
			}
		});

		if (more) {
			// Only surface the controls when there's more than one page to show
			// (so a small/filtered set doesn't render a lone "Showing 2 of 2").
			more.hidden = matched <= PAGE_SIZE;
			const shown = Math.min(visible, matched);
			if (status) {
				status.textContent = showingTemplate
					.replace('{shown}', String(shown))
					.replace('{total}', String(matched));
			}
			// Toggle via inline display, not [hidden]: the button is Button-scoped
			// (this component's CSS can't reach it) and .btn sets display anyway.
			if (loadMoreBtn) loadMoreBtn.style.display = matched > visible ? '' : 'none';
		}
	}

	filters.forEach((f) =>
		f.addEventListener('click', () => {
			activeTag = f.getAttribute('data-filter') ?? 'all';
			visible = PAGE_SIZE; // reset the pager when the filter changes
			filters.forEach((b) =>
				b.setAttribute('aria-pressed', String(b.getAttribute('data-filter') === activeTag)),
			);
			render();
		}),
	);

	loadMoreBtn?.addEventListener('click', () => {
		visible += PAGE_SIZE;
		render();
	});

	render();
</script>
