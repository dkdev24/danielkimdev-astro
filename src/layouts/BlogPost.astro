---
// Blog post layout (Stage 17) — renders a single post through the canonical
// BaseLayout shell. Owns the article chrome: header (date · reading-time ·
// locale badge, title, updated-date, tags, cross-language link), optional
// optimized hero image, a sticky/collapsible TOC beside a constrained prose
// body, prev/next pagination, and a back link. The CodeCopy enhancer is dropped
// once here so it upgrades every Shiki block in the body. Body MDX features
// (callouts, tables, footnotes, captioned images) come from remark-gfm + the
// Stage 12 components, styled by global.css.
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import CodeCopy from '../components/CodeCopy.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Tag from '../components/Tag.astro';
import Card from '../components/Card.astro';
import type { Lang } from '../i18n/utils';
import {
	formatDate,
	formatReadingTime,
	getAltLocale,
	getLocalizedPath,
	useTranslations,
} from '../i18n/utils';
import { DEFAULT_OG_IMAGE, SITE_TITLE } from '../consts';
import { readingTimeMinutes } from '../utils/readingTime';
import { getPostPath } from '../utils/blog';
import { getSeriesPath } from '../utils/series';
import { SERIES } from '../data/series';
import { blogPostingJsonLd } from '../utils/seo';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
	/** More-recent post in the same locale (reverse-chron neighbour). */
	newer?: CollectionEntry<'blog'>;
	/** Older post in the same locale. */
	older?: CollectionEntry<'blog'>;
	/** EN/KO counterpart (same `translationKey`), if one exists. */
	counterpart?: CollectionEntry<'blog'>;
	/** 1-based position within `post.data.series`, when set (Stage 30). */
	seriesIndex?: number;
	/** Total published parts in the series, when set. */
	seriesTotal?: number;
	/** Earlier part in the same series, if one exists. */
	seriesPrev?: CollectionEntry<'blog'>;
	/** Later part in the same series, if one exists. */
	seriesNext?: CollectionEntry<'blog'>;
	/** Same-locale posts ranked by shared tags, same-series excluded (Stage 31). */
	related?: CollectionEntry<'blog'>[];
}

const {
	post,
	headings,
	newer,
	older,
	counterpart,
	seriesIndex,
	seriesTotal,
	seriesPrev,
	seriesNext,
	related = [],
} = Astro.props;
const lang = post.data.lang as Lang;
const t = useTranslations(lang);
const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	heroImage,
	ogImage,
	series: seriesSlug,
	writingProcess,
} = post.data;
const seriesMeta = seriesSlug ? SERIES[seriesSlug] : undefined;

const blogHref = getLocalizedPath('/blog/', lang);
const localeBadge = lang === 'en' ? 'EN' : 'KO';
const minutes = readingTimeMinutes(post.body, lang);

// SEO (Stage 18). hreflang only when a translationKey counterpart exists.
const selfPath = getPostPath(post);
const postAlternates: { en?: string; ko?: string } | false = counterpart
	? { [lang]: selfPath, [getAltLocale(lang)]: getPostPath(counterpart) }
	: false;

const articleMeta = {
	publishedTime: pubDate.toISOString(),
	modifiedTime: updatedDate?.toISOString(),
	tags,
};

const siteUrl = Astro.site ?? new URL('https://danielkimdev.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageAbs = ogImage
	? new URL(ogImage, siteUrl).href
	: heroImage
		? new URL(heroImage.src, Astro.url).href
		: new URL(DEFAULT_OG_IMAGE, siteUrl).href;

const jsonLd = blogPostingJsonLd({
	siteUrl,
	url: pageUrl,
	title,
	description,
	datePublished: pubDate,
	dateModified: updatedDate,
	image: ogImageAbs,
	lang,
	tags,
});
---

<BaseLayout
	title={`${title} — ${SITE_TITLE}`}
	description={description}
	lang={lang}
	image={heroImage}
	ogImage={ogImage}
	articleMeta={articleMeta}
	alternates={postAlternates}
	jsonLd={jsonLd}
>
	<article class="post">
		<div class="container">
			<header class="post__header">
				<p class="post__meta">
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
					<span aria-hidden="true"> · </span>
					<span>{formatReadingTime(minutes, lang)}</span>
					<span aria-hidden="true"> · </span>
					<span class="post__locale" aria-label={t('lang.current')}>{localeBadge}</span>
					<span aria-hidden="true"> · </span>
					<span class="post__writing-process" title="Author's own provenance note (not independently verifiable)">
						{t(`blog.writingProcess.${writingProcess}`)}
					</span>
				</p>
				<h1 class="post__title">{title}</h1>
				{
					seriesMeta && (
						<p class="post__series">
							<a href={getSeriesPath(seriesSlug!, lang)}>
								{t('blog.seriesPartLabel', {
									n: seriesIndex ?? 1,
									total: seriesTotal ?? 1,
									series: seriesMeta.title[lang],
								})}
							</a>
						</p>
					)
				}
				{
					updatedDate && (
						<p class="post__updated">
							{t('blog.updatedOn')}{' '}
							<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time>
						</p>
					)
				}
				{
					tags.length > 0 && (
						<div class="post__tags">
							{tags.map((tg) => (
								<Tag tag={tg} lang={lang} />
							))}
						</div>
					)
				}
				{
					counterpart && (
						<p class="post__xlang">
							<a href={getPostPath(counterpart)}>{t('blog.readInOtherLang')} →</a>
						</p>
					)
				}
			</header>

			{
				heroImage && (
					<figure class="post__hero">
						<Image
							src={heroImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(max-width: 760px) 100vw, 720px"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				)
			}

			<div class="post__layout">
				{
					headings.length > 0 && (
						<aside class="post__toc">
							<TOC headings={headings} lang={lang} />
						</aside>
					)
				}
				<div class="prose post__body">
					<slot />
				</div>
			</div>

			{
				seriesMeta && (seriesPrev || seriesNext) && (
					<nav class="post__series-nav" aria-label={t('blog.seriesNav')}>
						<p class="post__series-nav-heading">{seriesMeta.title[lang]}</p>
						<div class="post__series-nav-links">
							{seriesPrev ? (
								<a class="post__pag post__pag--prev" href={getPostPath(seriesPrev)}>
									<span class="post__pag-label">← {t('blog.seriesPrev')}</span>
									<span class="post__pag-title">{seriesPrev.data.title}</span>
								</a>
							) : (
								<span />
							)}
							{seriesNext && (
								<a class="post__pag post__pag--next" href={getPostPath(seriesNext)}>
									<span class="post__pag-label">{t('blog.seriesNext')} →</span>
									<span class="post__pag-title">{seriesNext.data.title}</span>
								</a>
							)}
						</div>
					</nav>
				)
			}

			{
				related.length > 0 && (
					<section class="post__related" aria-labelledby="related-posts-heading">
						<h2 id="related-posts-heading" class="post__related-heading">
							{t('blog.relatedPosts')}
						</h2>
						<ul class="post__related-list">
							{related.map((rel) => {
								const relMinutes = readingTimeMinutes(rel.body, lang);
								return (
									<li>
										<Card as="article" interactive>
											<p class="post__related-meta">
												<time datetime={rel.data.pubDate.toISOString()}>
													{formatDate(rel.data.pubDate, lang)}
												</time>
												<span aria-hidden="true"> · </span>
												<span>{formatReadingTime(relMinutes, lang)}</span>
											</p>
											<h3 class="post__related-title">
												<a href={getPostPath(rel)}>{rel.data.title}</a>
											</h3>
											<p class="post__related-summary">{rel.data.description}</p>
										</Card>
									</li>
								);
							})}
						</ul>
					</section>
				)
			}

			{
				(newer || older) && (
					<nav class="post__pagination" aria-label={t('blog.morePosts')}>
						{older ? (
							<a class="post__pag post__pag--prev" href={getPostPath(older)}>
								<span class="post__pag-label">← {t('blog.olderPost')}</span>
								<span class="post__pag-title">{older.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{newer && (
							<a class="post__pag post__pag--next" href={getPostPath(newer)}>
								<span class="post__pag-label">{t('blog.newerPost')} →</span>
								<span class="post__pag-title">{newer.data.title}</span>
							</a>
						)}
					</nav>
				)
			}

			<p class="post__back">
				<a href={blogHref}>← {t('blog.backToBlog')}</a>
			</p>
		</div>
	</article>

	<!-- Enhances every Shiki code block in the body (language label + copy). -->
	<CodeCopy lang={lang} />
	<ReadingProgress />
</BaseLayout>

<style>
	.post {
		padding-block: var(--space-12) var(--space-16);
	}
	.post__header {
		margin-bottom: var(--space-8);
		max-width: 72ch;
	}
	.post__meta {
		margin: 0 0 var(--space-3);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post__locale {
		display: inline-block;
		padding: 0 var(--space-1_5);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
	}
	.post__title {
		font-size: var(--text-h1);
		margin: 0 0 var(--space-3);
	}
	.post__series {
		margin: 0 0 var(--space-3);
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}
	.post__series a {
		color: var(--color-brand-deep);
		text-decoration: none;
	}
	.post__series a:hover {
		text-decoration: underline;
	}
	.post__updated {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-style: italic;
		color: var(--color-text-muted);
	}
	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1_5);
		margin-bottom: var(--space-3);
	}
	.post__xlang {
		margin: 0;
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
	}

	.post__hero {
		margin: 0 0 var(--space-8);
		max-width: 72ch;
	}
	.post__hero :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	/*
	  Desktop: TOC sits in a sidebar column to the right of the body; on narrower
	  viewports it stacks above the body (still collapsible, see TOC.astro).
	*/
	.post__layout {
		display: grid;
		gap: var(--space-8);
	}
	@media (min-width: 1024px) {
		.post__layout {
			grid-template-columns: minmax(0, 1fr) 14rem;
			align-items: start;
		}
		.post__toc {
			order: 2;
		}
		.post__body {
			order: 1;
			min-width: 0;
		}
	}
	/* Generous reading measure (DESIGN-minimax §3) within the prose column. */
	.post__body {
		max-width: 72ch;
	}

	/* Series-scoped nav — visually distinct (tinted box + heading) from the
	   plain reverse-chron pagination below it, so the two aren't confused. */
	.post__series-nav {
		margin-top: var(--space-12);
		padding: var(--space-4) var(--space-6);
		background: var(--color-bg-muted);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-md);
	}
	.post__series-nav-heading {
		margin: 0 0 var(--space-4);
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.post__series-nav-links {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.post__related {
		margin-top: var(--space-12);
	}
	.post__related-heading {
		margin: 0 0 var(--space-4);
		font-size: var(--text-h4);
	}
	.post__related-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
		gap: var(--space-6);
	}
	.post__related-list li {
		height: 100%;
	}
	.post__related-list :global(.card) {
		height: 100%;
	}
	.post__related-meta {
		margin: 0 0 var(--space-2);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post__related-title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}
	.post__related-title a {
		color: var(--color-text-heading);
		text-decoration: none;
	}
	.post__related-title a:hover {
		color: var(--color-link);
	}
	.post__related-summary {
		margin: 0;
		color: var(--color-text-secondary);
	}

	.post__pagination {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border-subtle);
	}
	.post__pag {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		max-width: 48%;
		text-decoration: none;
		font-family: var(--font-ui);
	}
	.post__pag--next {
		text-align: right;
		margin-left: auto;
	}
	.post__pag-label {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post__pag-title {
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
	}
	.post__pag:hover .post__pag-title {
		color: var(--color-link);
	}

	.post__back {
		margin-top: var(--space-8);
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
	}
</style>
