---
// Blog post layout (Stage 17) — renders a single post through the canonical
// BaseLayout shell. Owns the article chrome: header (date · reading-time ·
// locale badge, title, updated-date, tags, cross-language link), optional
// optimized hero image, a sticky/collapsible TOC beside a constrained prose
// body, prev/next pagination, and a back link. The CodeCopy enhancer is dropped
// once here so it upgrades every Shiki block in the body. Body MDX features
// (callouts, tables, footnotes, captioned images) come from remark-gfm + the
// Stage 12 components, styled by global.css.
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Tag from '../components/Tag.astro';
import type { Lang } from '../i18n/utils';
import { formatDate, formatReadingTime, getLocalizedPath, useTranslations } from '../i18n/utils';
import { SITE_TITLE } from '../consts';
import { readingTimeMinutes } from '../utils/readingTime';
import { getPostPath } from '../utils/blog';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
	/** More-recent post in the same locale (reverse-chron neighbour). */
	newer?: CollectionEntry<'blog'>;
	/** Older post in the same locale. */
	older?: CollectionEntry<'blog'>;
	/** EN/KO counterpart (same `translationKey`), if one exists. */
	counterpart?: CollectionEntry<'blog'>;
}

const { post, headings, newer, older, counterpart } = Astro.props;
const lang = post.data.lang as Lang;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;

const blogHref = getLocalizedPath('/blog/', lang);
const localeBadge = lang === 'en' ? 'EN' : 'KO';
const minutes = readingTimeMinutes(post.body, lang);
---

<BaseLayout
	title={`${title} — ${SITE_TITLE}`}
	description={description}
	lang={lang}
	ogImage={heroImage}
>
	<article class="post">
		<div class="container container--prose">
			<header class="post__header">
				<p class="post__meta">
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
					<span aria-hidden="true"> · </span>
					<span>{formatReadingTime(minutes, lang)}</span>
					<span aria-hidden="true"> · </span>
					<span class="post__locale" aria-label={t('lang.current')}>{localeBadge}</span>
				</p>
				<h1 class="post__title">{title}</h1>
				{
					updatedDate && (
						<p class="post__updated">
							{t('blog.updatedOn')}{' '}
							<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time>
						</p>
					)
				}
				{
					tags.length > 0 && (
						<div class="post__tags">
							{tags.map((tg) => (
								<Tag tag={tg} lang={lang} />
							))}
						</div>
					)
				}
				{
					counterpart && (
						<p class="post__xlang">
							<a href={getPostPath(counterpart)}>{t('blog.readInOtherLang')} →</a>
						</p>
					)
				}
			</header>

			{
				heroImage && (
					<figure class="post__hero">
						<Image
							src={heroImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(max-width: 760px) 100vw, 720px"
						/>
					</figure>
				)
			}

			<div class="post__layout">
				{
					headings.length > 0 && (
						<aside class="post__toc">
							<TOC headings={headings} lang={lang} />
						</aside>
					)
				}
				<div class="prose post__body">
					<slot />
				</div>
			</div>

			{
				(newer || older) && (
					<nav class="post__pagination" aria-label={t('blog.morePosts')}>
						{older ? (
							<a class="post__pag post__pag--prev" href={getPostPath(older)}>
								<span class="post__pag-label">← {t('blog.olderPost')}</span>
								<span class="post__pag-title">{older.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{newer && (
							<a class="post__pag post__pag--next" href={getPostPath(newer)}>
								<span class="post__pag-label">{t('blog.newerPost')} →</span>
								<span class="post__pag-title">{newer.data.title}</span>
							</a>
						)}
					</nav>
				)
			}

			<p class="post__back">
				<a href={blogHref}>← {t('blog.backToBlog')}</a>
			</p>
		</div>
	</article>

	<!-- Enhances every Shiki code block in the body (language label + copy). -->
	<CodeCopy lang={lang} />
</BaseLayout>

<style>
	.post {
		padding-block: var(--space-12) var(--space-16);
	}
	.post__header {
		margin-bottom: var(--space-8);
	}
	.post__meta {
		margin: 0 0 var(--space-3);
		font-family: var(--font-data);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post__locale {
		display: inline-block;
		padding: 0 var(--space-1_5);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
	}
	.post__title {
		font-size: var(--text-h1);
		margin: 0 0 var(--space-3);
	}
	.post__updated {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-style: italic;
		color: var(--color-text-muted);
	}
	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1_5);
		margin-bottom: var(--space-3);
	}
	.post__xlang {
		margin: 0;
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
	}

	.post__hero {
		margin: 0 0 var(--space-8);
	}
	.post__hero :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	/*
	  Desktop: TOC sits in a sidebar column to the right of the body; on narrower
	  viewports it stacks above the body (still collapsible, see TOC.astro).
	*/
	.post__layout {
		display: grid;
		gap: var(--space-8);
	}
	@media (min-width: 1024px) {
		.post__layout {
			grid-template-columns: 1fr 14rem;
		}
		.post__toc {
			order: 2;
		}
		.post__body {
			order: 1;
			min-width: 0;
		}
	}
	/* Generous reading measure (DESIGN-minimax §3) within the prose column. */
	.post__body {
		max-width: 72ch;
	}

	.post__pagination {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border-subtle);
	}
	.post__pag {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		max-width: 48%;
		text-decoration: none;
		font-family: var(--font-ui);
	}
	.post__pag--next {
		text-align: right;
		margin-left: auto;
	}
	.post__pag-label {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.post__pag-title {
		font-weight: var(--weight-medium);
		color: var(--color-text-heading);
	}
	.post__pag:hover .post__pag-title {
		color: var(--color-link);
	}

	.post__back {
		margin-top: var(--space-8);
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
	}
</style>
