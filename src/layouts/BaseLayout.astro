---
// The canonical page shell every page renders through (Stage 06). Owns the
// document scaffold — <html lang>, <head> (via BaseHead), no-flash theme, the
// skip link, and the header/main/footer landmarks — so pages only supply their
// content (and, later, header/footer chrome).
//
// Header and footer are placeholder landmark slots here; Stage 07/08 inject the
// real Header/Footer. A page can override them via the `header` / `footer`
// named slots; otherwise empty landmark elements keep the document well-formed.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import CobaltHeader from '../components/CobaltHeader.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/utils';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	/** Optimized OG image (e.g. a post hero); falls back to BaseHead's default. */
	image?: ImageMetadata;
	/** Explicit OG image path override (e.g. post `ogImage` frontmatter). */
	ogImage?: string;
	/** Marks the page as an article (posts) for OpenGraph. */
	articleMeta?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
	/**
	 * hreflang counterparts. Omit on a mirrored page (Home/About/Portfolio/Blog
	 * index) and the layout auto-derives the EN/KO pair from the current path.
	 * Pass `false` to suppress (e.g. 404), or an explicit `{ en?, ko? }` for pages
	 * whose counterpart may not exist (posts).
	 */
	alternates?: { en?: string; ko?: string } | false;
	/** Structured data (JSON-LD) for this page. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Keep this page out of search indexes (404, throwaway pages). */
	noindex?: boolean;
}

const {
	title,
	description,
	lang,
	image,
	ogImage,
	articleMeta,
	alternates,
	jsonLd,
	noindex = false,
} = Astro.props;
const t = useTranslations(lang);

// hreflang resolution: explicit object wins; `false` or noindex suppresses;
// otherwise auto-derive both locales from the current path (mirrored pages).
const path = Astro.url.pathname;
const resolvedAlternates =
	alternates === false || noindex
		? undefined
		: (alternates ?? { en: getLocalizedPath(path, 'en'), ko: getLocalizedPath(path, 'ko') });
---

<!doctype html>
<html lang={lang}>
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-JL3PJ65QL3"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-JL3PJ65QL3');
		</script>
		<BaseHead
			title={title}
			description={description}
			lang={lang}
			image={image}
			ogImage={ogImage}
			articleMeta={articleMeta}
			alternates={resolvedAlternates}
			jsonLd={jsonLd}
			noindex={noindex}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

		{/* Agent-readiness directive (body-level, not head — scanners check body).
		    Clip-rect hides it visually while keeping it present in the DOM.
		    Points agents to the full site index and the per-page .md endpoint. */}
		<a
			href="/llms.txt"
			style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;"
		>
			This site is also available as markdown for AI agents. For a complete
			index of all pages, see the site index at /llms.txt
		</a>

		<slot name="header">
			<CobaltHeader />
		</slot>

		<main id="main" class="site-main">
			<slot />
		</main>

		<slot name="footer">
			<Footer />
		</slot>
	</body>
</html>

<style>
	/*
	  Skip link — first focusable element on the page (PRD §11 a11y). Hidden off
	  the top of the viewport until focused, then slides in. Jumps to #main.
	*/
	.skip-link {
		position: fixed;
		top: 0;
		left: var(--space-4);
		z-index: 100;
		transform: translateY(-120%);
		padding: var(--space-2) var(--space-4);
		background: var(--color-bg);
		color: var(--color-link);
		border: 1px solid var(--color-border);
		border-top: none;
		border-radius: 0 0 var(--radius-sm) var(--radius-sm);
		font-family: var(--font-ui);
		font-weight: var(--weight-medium);
		text-decoration: none;
		transition: transform var(--motion-fast, 150ms) ease;
	}
	.skip-link:focus {
		transform: translateY(0);
	}

	/*
	  The shell's main is a full-width flow region (overrides the legacy prose-
	  width `main` rule in global.css). Pages constrain their own content with
	  `.container`, keeping full-bleed sections possible (DESIGN-minimax §1).
	*/
	.site-main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	/* Body is a column so a sticky footer sits below content on short pages. */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.site-main {
		flex: 1 0 auto;
	}
</style>
