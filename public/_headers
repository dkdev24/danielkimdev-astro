# Cloudflare Pages custom headers (https://developers.cloudflare.com/pages/configuration/headers/)
# CSP finalized 2026-06-29 (post-deploy Lighthouse, stage-21-deploy.md): script-src
# allows 'unsafe-inline' for the no-flash inline theme script (ThemeScript.astro,
# is:inline) and the Cloudflare Web Analytics beacon origin; connect-src allows the
# beacon's report endpoint. 'unsafe-inline' is the pragmatic choice for a no-auth
# static site (no per-build hash maintenance). style-src already allows inline.
# Umami Cloud added 2026-08-05: script-src needs cloud.umami.is (the tracker file)
# and connect-src needs gateway.umami.is (where script.js POSTs /api/send) — two
# different hosts, so allow-listing only cloud.umami.is silently drops every event.
# GA4 (gtag.js) added 2026-08-06: script-src needs www.googletagmanager.com (loader);
# connect-src needs www.google-analytics.com + region1.google-analytics.com (gtag
# collect beacons, region-sharded per user); img-src needs www.google-analytics.com
# as a no-JS fallback pixel path.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cloud.umami.is https://www.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://gateway.umami.is https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Agent-readiness: Link header on / so agents can discover major sections without crawling.
# Vary: Accept is set here as a static fallback; the middleware (functions/_middleware.ts)
# also sets it dynamically on negotiated responses.
/
  Link: </blog/>; rel="service-doc"; title="Blog", </portfolio/>; rel="service-doc"; title="Portfolio", </about/>; rel="service-doc"; title="About"
  Vary: Accept

# Markdown siblings: explicit Content-Type for pre-built .md files.
# (Middleware also sets this for Accept-negotiated responses at pretty URLs.)
/*.md
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept

# Astro emits content-hashed assets under /_astro/* — safe to cache forever (immutable).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
